# ==================== SERVER ====================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ==================== DATABASE ====================
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/hiring_platform?schema=public"

# ==================== JWT ====================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-long
JWT_REFRESH_EXPIRE=30d

# ==================== EMAIL (SMTP) ====================
EMAIL_SERVICE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Your Company HR

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== FILE UPLOAD ====================
MAX_BULK_UPLOAD_SIZE=52428800
ALLOWED_BULK_TYPES=text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ==================== FEATURE FLAGS ====================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== SECURITY ====================
BCRYPT_ROUNDS=12
