// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================

enum UserRole {
  ADMIN
  HR
  RECRUITER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole @default(RECRUITER)
  isActive      Boolean  @default(true)
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  createdJDs    JobDescription[] @relation("CreatedBy")
  feedbacks     Feedback[]
  activities    ActivityLog[]
  
  @@index([email])
  @@index([role])
  @@map("users")
}

// ==================== JOB DESCRIPTIONS ====================

enum JDStatus {
  ACTIVE
  PAUSED
  CLOSED
  DRAFT
}

model JobDescription {
  id                String       @id @default(uuid())
  title             String
  description       String       @db.Text
  department        String
  location          String?
  
  // Status
  status            JDStatus     @default(DRAFT)
  
  // Compensation
  salaryMin         Decimal?     @db.Decimal(10, 2)
  salaryMax         Decimal?     @db.Decimal(10, 2)
  openings          Int          @default(1)
  
  // Eligibility criteria (for bulk hiring)
  eligibleDegrees   String[]     @default([])  // ["B.Tech", "B.E", "MCA", "M.Tech"]
  eligibleStreams   String[]     @default([])  // ["Computer Science", "IT", "Electronics"]
  eligibleYears     Int[]        @default([])  // [2024, 2025, 2026]
  minCGPA           Decimal?     @db.Decimal(4, 2)
  
  // Additional requirements
  responsibilities  String?      @db.Text
  skills            String[]     @default([])  // ["Java", "React", "SQL"]
  
  // Job details
  employmentType    String?      // "Full-time", "Internship", "Contract"
  experienceLevel   String?      // "Fresher", "0-2 years"
  workMode          String?      // "Onsite", "Remote", "Hybrid"
  
  // Metadata
  createdById       String
  createdBy         User         @relation("CreatedBy", fields: [createdById], references: [id])
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  // Relations
  candidates        Candidate[]
  stages            Stage[]
  communications    Communication[]
  dashboard         Dashboard?
  
  @@index([status])
  @@index([createdById])
  @@map("job_descriptions")
}

// ==================== CANDIDATES ====================

model Candidate {
  id                String          @id @default(uuid())
  
  // Basic Information
  name              String
  email             String
  phone             String
  alternatePhone    String?
  
  // College/Fresher Information
  college           String
  degree            String
  branch            String?
  passOutYear       Int
  cgpa              Decimal?        @db.Decimal(4, 2)
  backlogs          Int?             @default(0)
  tenthPercentage   Decimal?         @db.Decimal(5, 2)
  twelfthPercentage Decimal?         @db.Decimal(5, 2)
  
  // Resume (Google Drive Link)
  resumeLink        String?

  address           String?         // Full address
  city              String?         // City for location-based filtering
  state             String?         // State
  pincode           String?         // Pincode
  
  // System fields
  isEligible        Boolean         @default(false)
  currentStageId    String?
  currentStage      Stage?          @relation("CurrentStage", fields: [currentStageId], references: [id])
  
  // JD Reference
  jdId              String
  jd                JobDescription  @relation(fields: [jdId], references: [id], onDelete: Cascade)
  
  // Tags for filtering (college names, etc)
  tags              String[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  stageHistory      CandidateStage[]
  feedbacks         Feedback[]
  communications    CandidateComm[]
  
  @@unique([email, jdId])
  @@index([jdId])
  @@index([email])
  @@index([college])
  @@index([currentStageId])
  @@index([isEligible])
  @@index([passOutYear])
  @@index([degree])           // ADD: For filtering by degree
  @@index([branch])           // ADD: For filtering by branch
  @@index([cgpa])             // ADD: For CGPA-based queries
  @@index([createdAt])        // ADD: For sorting by application date
  @@index([city])
  @@map("candidates")
}

// ==================== STAGES & WORKFLOW ====================

enum StageType {
  APPLIED
  SHORTLISTED
  INTERVIEWED
  SELECTED
  REJECTED
}

model Stage {
  id              String        @id @default(uuid())
  name            String
  type            StageType
  order           Int
  description     String?
  isActive        Boolean       @default(true)
  
  jdId            String
  jd              JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  candidateStages CandidateStage[]
  currentCandidates Candidate[] @relation("CurrentStage")
  
  @@unique([jdId, order])
  @@index([jdId])
  @@map("stages")
}

model CandidateStage {
  id              String    @id @default(uuid())
  
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  stageId         String
  stage           Stage     @relation(fields: [stageId], references: [id])
  
  enteredAt       DateTime  @default(now())
  exitedAt        DateTime?
  
  notes           String?   @db.Text
  interviewDate   DateTime?
  interviewMode   String?
  interviewerName String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([candidateId])
  @@index([stageId])
  @@map("candidate_stages")
}

// ==================== FEEDBACK & RATINGS ====================

model Feedback {
  id              String    @id @default(uuid())
  
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  givenById       String
  givenBy         User      @relation(fields: [givenById], references: [id])
  
  rating          Int       // 1-5 scale
  comments        String    @db.Text
  
  technicalSkills Int?      // 1-5
  communication   Int?      // 1-5
  cultureFit      Int?      // 1-5
  problemSolving  Int?      // 1-5
  
  recommendation  String?   // "STRONG_YES", "YES", "MAYBE", "NO"
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([candidateId])
  @@index([givenById])
  @@map("feedbacks")
}

// ==================== COMMUNICATION ====================

enum CommChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum CommStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model Communication {
  id              String         @id @default(uuid())
  
  jdId            String
  jd              JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  
  channel         CommChannel
  templateId      String?
  template        Template?      @relation(fields: [templateId], references: [id])
  
  subject         String?
  message         String         @db.Text
  
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  
  scheduledAt     DateTime?
  sentAt          DateTime?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  recipients      CandidateComm[]
  
  @@index([jdId])
  @@index([channel])
  @@map("communications")
}

model CandidateComm {
  id                String         @id @default(uuid())
  
  communicationId   String
  communication     Communication  @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  
  candidateId       String
  candidate         Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  status            CommStatus     @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  failureReason     String?
  
  @@index([communicationId])
  @@index([candidateId])
  @@index([status])
  @@map("candidate_communications")
}

model Template {
  id              String    @id @default(uuid())
  name            String
  channel         CommChannel
  category        String    // "INTERVIEW_CALL", "TEST_LINK", "REJECTION", "OFFER"
  subject         String?
  body            String    @db.Text
  variables       String[]  // ["candidate_name", "interview_date"]
  
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  communications  Communication[]
  
  @@index([category])
  @@index([channel])
  @@map("templates")
}

// ==================== BULK UPLOAD ====================

enum UploadStatus {
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

model BulkUpload {
  id              String       @id @default(uuid())
  jdId            String
  fileName        String
  fileUrl         String?
  
  totalRows       Int          @default(0)
  successCount    Int          @default(0)
  failureCount    Int          @default(0)
  
  status          UploadStatus @default(PROCESSING)
  errorLog        Json?
  
  uploadedBy      String
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([jdId])
  @@index([status])
  @@index([uploadedBy])       // ADD: Track who uploaded
  @@index([createdAt])        // ADD: Sort by upload date
  @@map("bulk_uploads")
}

// ==================== ANALYTICS & LOGS ====================

model ActivityLog {
  id              String   @id @default(uuid())
  
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  action          String
  entityType      String
  entityId        String
  
  metadata        Json?
  ipAddress       String?
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Dashboard {
  id              String   @id @default(uuid())
  jdId            String   @unique

  jd              JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  
  totalCandidates Int      @default(0)
  eligibleCount   Int      @default(0)
  shortlistedCount Int     @default(0)
  interviewedCount Int     @default(0)
  selectedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  
  avgTimeToHire   Int?     // in days
  avgRating       Decimal? @db.Decimal(3, 2)
  
  lastUpdated     DateTime @default(now())
  
  @@index([jdId])
  @@map("dashboards")
}

model CollegePerformance {
  id              String   @id @default(uuid())
  jdId            String
  collegeName     String
  
  totalApplied    Int      @default(0)
  totalEligible   Int      @default(0)
  totalShortlisted Int     @default(0)
  totalSelected   Int      @default(0)
  
  avgCGPA         Decimal? @db.Decimal(3, 2)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([jdId, collegeName])
  @@index([jdId])
  @@index([collegeName])      // ADD: Search by college
  @@index([totalSelected])    // ADD: Sort by performance
  @@map("college_performance")
}
