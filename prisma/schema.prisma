// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================

enum UserRole {
  ADMIN
  HR
  RECRUITER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole @default(RECRUITER)
  isActive      Boolean  @default(true)
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  createdJDs    JobDescription[] @relation("CreatedBy")
  feedbacks     Feedback[]
  activities    ActivityLog[]
  
  @@index([email])
  @@index([role])
  @@map("users")
}

// ==================== JOB DESCRIPTIONS ====================

enum HiringType {
  BULK        // For freshers/college hiring
  NORMAL      // For experienced candidates
}

enum JDStatus {
  ACTIVE
  PAUSED
  CLOSED
  DRAFT
}

model JobDescription {
  id                String       @id @default(uuid())
  title             String
  description       String       @db.Text
  department        String
  hiringType        HiringType
  status            JDStatus     @default(ACTIVE)
  location          String?
  salaryMin         Decimal?     @db.Decimal(10, 2)
  salaryMax         Decimal?     @db.Decimal(10, 2)
  openings          Int          @default(1)
  
  // Eligibility criteria for bulk hiring
  eligibleDegrees   String[]     // ["B.Tech", "MCA"]
  eligibleYears     Int[]        // [2024, 2025, 2026]
  minCGPA           Decimal?     @db.Decimal(3, 2)
  
  // Requirements for normal hiring
  experienceMin     Int?         // in years
  experienceMax     Int?
  requiredSkills    String[]
  preferredSkills   String[]
  
  createdById       String
  createdBy         User         @relation("CreatedBy", fields: [createdById], references: [id])
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  // Relations
  candidates        Candidate[]
  stages            Stage[]
  communications    Communication[]
  
  @@index([status])
  @@index([hiringType])
  @@index([createdById])
  @@map("job_descriptions")
}

// ==================== CANDIDATES ====================

enum CandidateSource {
  BULK_UPLOAD
  MANUAL_UPLOAD
  CAREER_PORTAL
  REFERRAL
  LINKEDIN
  OTHER
}

model Candidate {
  id                String          @id @default(uuid())
  
  // Basic Information
  name              String
  email             String
  phone             String
  alternatePhone    String?
  
  // For Bulk Hiring (Freshers)
  college           String?
  degree            String?
  branch            String?
  passOutYear       Int?
  cgpa              Decimal?        @db.Decimal(3, 2)
  
  // For Normal Hiring (Experienced)
  currentCompany    String?
  previousCompany   String?
  totalExperience   Decimal?        @db.Decimal(4, 1) // in years
  relevantExp       Decimal?        @db.Decimal(4, 1)
  skills            String[]
  currentLocation   String?
  preferredLocation String?
  currentCTC        Decimal?        @db.Decimal(10, 2)
  expectedCTC       Decimal?        @db.Decimal(10, 2)
  noticePeriod      Int?            // in days
  
  // Resume & Documents
  resumeUrl         String?
  resumeFileName    String?
  portfolioUrl      String?
  linkedinUrl       String?
  githubUrl         String?
  
  // System fields
  source            CandidateSource @default(MANUAL_UPLOAD)
  isEligible        Boolean         @default(false)
  currentStageId    String?
  currentStage      Stage?          @relation("CurrentStage", fields: [currentStageId], references: [id])
  
  // JD Reference
  jdId              String
  jd                JobDescription  @relation(fields: [jdId], references: [id], onDelete: Cascade)
  
  // Tags for filtering
  tags              String[]        // ["college_abc", "referral", "priority"]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  // Relations
  stageHistory      CandidateStage[]
  feedbacks         Feedback[]
  communications    CandidateComm[]
  
  @@unique([email, jdId]) // Same candidate can't apply twice to same JD
  @@index([jdId])
  @@index([email])
  @@index([college])
  @@index([currentStageId])
  @@index([isEligible])
  @@index([passOutYear])
  @@map("candidates")
}

// ==================== STAGES & WORKFLOW ====================

enum StageType {
  // Bulk Hiring Stages
  APPLIED
  SHORTLISTED
  INTERVIEWED
  SELECTED
  REJECTED
  
  // Normal Hiring Stages
  HR_ROUND
  TECHNICAL_ROUND
  MANAGER_ROUND
  CLIENT_ROUND
  OFFER_RELEASED
  OFFER_ACCEPTED
  JOINED
  DROPPED
}

model Stage {
  id              String        @id @default(uuid())
  name            String
  type            StageType
  order           Int           // Sequence of stages
  description     String?
  isActive        Boolean       @default(true)
  
  jdId            String
  jd              JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relations
  candidateStages CandidateStage[]
  currentCandidates Candidate[] @relation("CurrentStage")
  
  @@unique([jdId, order])
  @@index([jdId])
  @@map("stages")
}

model CandidateStage {
  id              String    @id @default(uuid())
  
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  stageId         String
  stage           Stage     @relation(fields: [stageId], references: [id])
  
  enteredAt       DateTime  @default(now())
  exitedAt        DateTime?
  
  notes           String?   @db.Text
  interviewDate   DateTime?
  interviewMode   String?   // "In-person", "Video", "Phone"
  interviewerName String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([candidateId])
  @@index([stageId])
  @@map("candidate_stages")
}

// ==================== FEEDBACK & RATINGS ====================

model Feedback {
  id              String    @id @default(uuid())
  
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  givenById       String
  givenBy         User      @relation(fields: [givenById], references: [id])
  
  rating          Int       // 1-5 scale
  comments        String    @db.Text
  
  // Detailed assessment
  technicalSkills Int?      // 1-5
  communication   Int?      // 1-5
  cultureFit      Int?      // 1-5
  problemSolving  Int?      // 1-5
  
  recommendation  String?   // "STRONG_YES", "YES", "MAYBE", "NO"
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([candidateId])
  @@index([givenById])
  @@map("feedbacks")
}

// ==================== COMMUNICATION ====================

enum CommChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum CommStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

model Communication {
  id              String         @id @default(uuid())
  
  jdId            String
  jd              JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  
  channel         CommChannel
  templateId      String?
  template        Template?      @relation(fields: [templateId], references: [id])
  
  subject         String?
  message         String         @db.Text
  
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  
  scheduledAt     DateTime?
  sentAt          DateTime?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Relations
  recipients      CandidateComm[]
  
  @@index([jdId])
  @@index([channel])
  @@map("communications")
}

model CandidateComm {
  id                String         @id @default(uuid())
  
  communicationId   String
  communication     Communication  @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  
  candidateId       String
  candidate         Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  status            CommStatus     @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failureReason     String?
  
  @@index([communicationId])
  @@index([candidateId])
  @@index([status])
  @@map("candidate_communications")
}

model Template {
  id              String    @id @default(uuid())
  name            String
  channel         CommChannel
  category        String    // "INTERVIEW_CALL", "TEST_LINK", "REJECTION", "OFFER"
  subject         String?
  body            String    @db.Text
  variables       String[]  // ["candidate_name", "interview_date", "test_link"]
  
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  communications  Communication[]
  
  @@index([category])
  @@index([channel])
  @@map("templates")
}

// ==================== BULK UPLOAD ====================

enum UploadStatus {
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

model BulkUpload {
  id              String       @id @default(uuid())
  jdId            String
  fileName        String
  fileUrl         String
  
  totalRows       Int          @default(0)
  successCount    Int          @default(0)
  failureCount    Int          @default(0)
  
  status          UploadStatus @default(PROCESSING)
  errorLog        Json?        // Store error details
  
  uploadedBy      String       // User ID
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([jdId])
  @@index([status])
  @@map("bulk_uploads")
}

// ==================== ANALYTICS & LOGS ====================

model ActivityLog {
  id              String   @id @default(uuid())
  
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  action          String   // "CANDIDATE_CREATED", "STAGE_CHANGED", "BULK_UPLOAD"
  entityType      String   // "CANDIDATE", "JD", "COMMUNICATION"
  entityId        String
  
  metadata        Json?    // Additional context
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Dashboard {
  id              String   @id @default(uuid())
  jdId            String   @unique
  
  // Aggregate stats (updated periodically or via triggers)
  totalCandidates Int      @default(0)
  eligibleCount   Int      @default(0)
  shortlistedCount Int     @default(0)
  interviewedCount Int     @default(0)
  selectedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  droppedCount    Int      @default(0)
  
  // Average metrics
  avgTimeToHire   Int?     // in days
  avgRating       Decimal? @db.Decimal(3, 2)
  
  lastUpdated     DateTime @default(now())
  
  @@index([jdId])
  @@map("dashboards")
}

// ==================== COLLEGE PERFORMANCE (for bulk hiring) ====================

model CollegePerformance {
  id              String   @id @default(uuid())
  jdId            String
  collegeName     String
  
  totalApplied    Int      @default(0)
  totalEligible   Int      @default(0)
  totalShortlisted Int     @default(0)
  totalSelected   Int      @default(0)
  
  avgCGPA         Decimal? @db.Decimal(3, 2)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([jdId, collegeName])
  @@index([jdId])
  @@map("college_performance")
}
