// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================

enum UserRole {
  ADMIN
  HR
  RECRUITER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(RECRUITER)
  isActive  Boolean  @default(true)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdJDs  JobDescription[] @relation("CreatedBy")
  feedbacks   Feedback[]
  activities  ActivityLog[]
  bulkUploads BulkUpload[]
  sentEmails       Email[]
  createdTemplates EmailTemplate[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ==================== JOB DESCRIPTIONS ====================

enum JDStatus {
  ACTIVE
  PAUSED
  CLOSED
  DRAFT
}

model JobDescription {
  id          String  @id @default(uuid())
  title       String
  description String  @db.Text
  department  String
  location    String?

  // Status
  status JDStatus @default(DRAFT)

  // Compensation
  salaryMin Decimal? @db.Decimal(10, 2)
  salaryMax Decimal? @db.Decimal(10, 2)
  openings  Int      @default(1)

  // Eligibility criteria (for bulk hiring)
  eligibleDegrees String[] @default([]) // ["B.Tech", "B.E", "MCA", "M.Tech"]
  eligibleStreams String[] @default([]) // ["Computer Science", "IT", "Electronics"]
  eligibleYears   Int[]    @default([]) // [2024, 2025, 2026]
  minCGPA         Decimal? @db.Decimal(4, 2)

  // Additional requirements
  responsibilities String?  @db.Text
  skills           String[] @default([]) // ["Java", "React", "SQL"]

  // Job details
  employmentType  String? // "Full-time", "Internship", "Contract"
  experienceLevel String? // "Fresher", "0-2 years"
  workMode        String? // "Onsite", "Remote", "Hybrid"

  // Metadata
  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  candidates     Candidate[]
  stages         Stage[]
  emails         Email[]
  dashboard      Dashboard?
  bulkUploads    BulkUpload[]

  @@index([status])
  @@index([createdById])
  @@map("job_descriptions")
}

// ==================== CANDIDATES ====================

model Candidate {
  id String @id @default(uuid())

  // Basic Information
  name           String
  email          String
  phone          String
  alternatePhone String?
  dateOfBirth    DateTime? // ADD: For age-based filtering
  gender         String? // ADD: For diversity reporting

  // College/Fresher Information
  college           String
  degree            String // "B.Tech", "M.Tech", "MCA"
  branch            String? // "Computer Science", "IT"
  stream            String? // ADD: Alternative to branch (more flexible)
  passOutYear       Int
  cgpa              Decimal? @db.Decimal(4, 2)
  backlogs          Int?     @default(0)
  activeBacklogs    Int?     @default(0) // ADD: Current backlogs vs total
  tenthPercentage   Decimal? @db.Decimal(5, 2)
  twelfthPercentage Decimal? @db.Decimal(5, 2)

  // Documents
  resumeLink    String? // Google Drive/S3 URL
  photoUrl      String? // ADD: Candidate photo
  idProofUrl    String? // ADD: Aadhar/PAN for verification
  marksheetUrls String[] @default([]) // ADD: Multiple marksheet links

  // Contact & Location
  address String?
  city    String?
  state   String?
  pincode String?
  country String? @default("India") // ADD: For international hiring

  // Skills & Experience
  skills            String[] @default([]) // ADD: Technical skills
  certifications    String[] @default([]) // ADD: Course certifications
  projects          String[] @default([]) // ADD: Project titles/links
  internships       String[] @default([]) // ADD: Internship experience
  hasWorkExperience Boolean  @default(false) // ADD: Experience flag
  yearsOfExperience Decimal? @db.Decimal(3, 1) // ADD: Years of experience

  // Application Status
  isEligible          Boolean @default(false)
  ineligibilityReason String? // ADD: Why candidate is ineligible
  applicationStatus   String? @default("PENDING") // ADD: PENDING, REVIEWING, PROCESSED
  currentStageId      String?
  currentStage        Stage?  @relation("CurrentStage", fields: [currentStageId], references: [id])

  // Interview & Assessment
  interviewScore Decimal? @db.Decimal(5, 2) // ADD: Interview rating
  technicalScore Decimal? @db.Decimal(5, 2) // ADD: Technical test score
  hrScore        Decimal? @db.Decimal(5, 2) // ADD: HR round score
  overallRating  Decimal? @db.Decimal(3, 2) // ADD: Combined rating

  // Offer Details
  offerStatus    String? // ADD: PENDING, SENT, ACCEPTED, REJECTED
  offerLetterUrl String? // ADD: Offer letter link
  offeredCTC     Decimal?  @db.Decimal(10, 2) // ADD: Offered salary
  joiningDate    DateTime? // ADD: Expected joining date
  hasJoined      Boolean   @default(false) // ADD: Actual joining status

  // JD Reference
  jdId String
  jd   JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)

  // Tags for filtering (college names, etc)
  tags String[]

  // Timestamps
  appliedAt      DateTime @default(now()) // ADD: Separate from createdAt
  lastActivityAt DateTime @default(now()) // ADD: Track last interaction
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  stageHistory   CandidateStage[]
  feedbacks      Feedback[]
  emails         CandidateEmail[]

  @@unique([email, jdId])
  @@index([jdId])
  @@index([email])
  @@index([phone]) // ADD: Search by phone
  @@index([college])
  @@index([degree])
  @@index([branch])
  @@index([stream]) // ADD: Index stream
  @@index([passOutYear])
  @@index([cgpa])
  @@index([currentStageId])
  @@index([isEligible])
  @@index([applicationStatus]) // ADD: Filter by status
  @@index([offerStatus]) // ADD: Filter by offer status
  @@index([city])
  @@index([state]) // ADD: State-wise filtering
  @@index([hasWorkExperience]) // ADD: Filter experienced candidates
  @@index([appliedAt]) // ADD: Sort by application date
  @@index([lastActivityAt]) // ADD: Sort by recent activity
  @@index([createdAt])
  @@map("candidates")
}

// ==================== STAGES & WORKFLOW ====================

enum StageType {
  APPLIED
  SHORTLISTED
  INTERVIEWED
  SELECTED
  REJECTED
}

model Stage {
  id          String    @id @default(uuid())
  name        String
  type        StageType
  order       Int
  description String?
  isActive    Boolean   @default(true)

  jdId String
  jd   JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateStages   CandidateStage[]
  currentCandidates Candidate[]      @relation("CurrentStage")

  @@unique([jdId, order])
  @@index([jdId])
  @@map("stages")
}

model CandidateStage {
  id String @id @default(uuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  enteredAt DateTime  @default(now())
  exitedAt  DateTime?

  notes           String?   @db.Text
  interviewDate   DateTime?
  interviewMode   String?
  interviewerName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([stageId])
  @@map("candidate_stages")
}

// ==================== FEEDBACK & RATINGS ====================

model Feedback {
  id String @id @default(uuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  givenById String
  givenBy   User   @relation(fields: [givenById], references: [id])

  rating   Int // 1-5 scale
  comments String @db.Text

  technicalSkills Int? // 1-5
  communication   Int? // 1-5
  cultureFit      Int? // 1-5
  problemSolving  Int? // 1-5

  recommendation String? // "STRONG_YES", "YES", "MAYBE", "NO"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([givenById])
  @@map("feedbacks")
}

// ==================== COMMUNICATION (EMAIL ONLY) ====================

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum EmailType {
  BULK          // Sent to multiple candidates
  INDIVIDUAL    // Sent to single candidate
}

enum TemplateCategory {
  INTERVIEW_CALL
  TEST_LINK
  REJECTION
  OFFER
  SHORTLIST
  REMINDER
  FEEDBACK_REQUEST
  ONBOARDING
  GENERAL
}

model Email {
  id String @id @default(uuid())

  // Relation
  jdId String
  jd   JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)

  // Email details
  type EmailType @default(BULK)
  
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  subject String
  message String @db.Text
  htmlBody String? @db.Text
  
  // Attachments (file paths or URLs)
  attachments String[] @default([])
  
  // Personalization variables
  variables Json? // { "interview_date": "2026-02-10", "time": "10:00 AM" }

  // Recipient filters
  filters Json? // { "stage": "SHORTLISTED", "eligible": true }

  // Stats
  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  deliveredCount  Int @default(0)
  failedCount     Int @default(0)
  bouncedCount    Int @default(0)

  // Scheduling
  scheduledAt DateTime?
  sentAt      DateTime?
  completedAt DateTime?

  // Priority
  priority Int @default(0)

  // Sent by
  sentBy String
  sender User   @relation(fields: [sentBy], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients CandidateEmail[]

  @@index([jdId])
  @@index([type])
  @@index([sentBy])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("emails")
}

model CandidateEmail {
  id String @id @default(uuid())

  emailId String
  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Recipient details (snapshot at send time)
  recipientEmail String
  recipientName  String

  // Personalized content (after variable replacement)
  personalizedSubject String
  personalizedMessage String @db.Text
  personalizedHtmlBody String? @db.Text

  // Status tracking
  status    EmailStatus @default(PENDING)
  sentAt    DateTime?
  failedAt  DateTime?
  
  failureReason String?
  
  // SMTP response
  smtpResponse String? // SMTP server response
  messageId    String? // Message-ID header

  // Retry logic
  retryCount Int @default(0)
  maxRetries Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emailId])
  @@index([candidateId])
  @@index([status])
  @@index([sentAt])
  @@index([recipientEmail])
  @@map("candidate_emails")
}

model EmailTemplate {
  id String @id @default(uuid())

  name        String
  description String? @db.Text
  
  category TemplateCategory
  
  subject  String
  body     String @db.Text
  htmlBody String? @db.Text
  
  // Variables that can be used in template
  // e.g., {{candidate_name}}, {{interview_date}}, {{test_link}}
  variables String[] @default([])
  
  // Default values for variables
  defaultValues Json? // { "company_name": "Acme Corp", "hr_email": "hr@acme.com" }
  
  // Preview data for testing
  previewData Json? // { "candidate_name": "John Doe", "interview_date": "2026-02-15" }

  // Default attachments
  attachments String[] @default([])

  // Usage stats
  usageCount Int @default(0)
  lastUsedAt DateTime?
  
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  // Access control
  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails Email[]

  @@index([category])
  @@index([isActive])
  @@index([createdBy])
  @@map("email_templates")
}

// ==================== BULK UPLOAD ====================

enum UploadStatus {
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

model BulkUpload {
  id String @id @default(uuid())

  // Relation
  jdId String
  jd   JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)

  // File info
  fileName String
  fileUrl  String?
  fileSize Int? // bytes (useful for debugging large uploads)
  fileType String? // csv, xlsx, etc.

  // Processing stats
  totalRows     Int @default(0)
  successCount  Int @default(0)
  failureCount  Int @default(0)
  processedRows Int @default(0) // progress tracking

  // Status
  status UploadStatus @default(PROCESSING)

  // Error handling
  errorLog     Json? // detailed row-level errors
  errorMessage String? // high-level failure reason

  // Audit
  uploadedBy String
  uploader   User   @relation(fields: [uploadedBy], references: [id])

  // Retry support
  retryCount Int @default(0)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([jdId])
  @@index([status])
  @@index([uploadedBy])
  @@index([createdAt])
  @@index([status, createdAt]) // dashboard queries
  @@map("bulk_uploads")
}

// ==================== ANALYTICS & LOGS ====================

model ActivityLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String

  metadata  Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Dashboard {
  id   String @id @default(uuid())
  jdId String @unique

  jd JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)

  totalCandidates  Int @default(0)
  eligibleCount    Int @default(0)
  shortlistedCount Int @default(0)
  interviewedCount Int @default(0)
  selectedCount    Int @default(0)
  rejectedCount    Int @default(0)

  avgTimeToHire Int? // in days
  avgRating     Decimal? @db.Decimal(3, 2)

  lastUpdated DateTime @default(now())

  @@index([jdId])
  @@map("dashboards")
}

model CollegePerformance {
  id          String @id @default(uuid())
  jdId        String
  collegeName String

  totalApplied     Int @default(0)
  totalEligible    Int @default(0)
  totalShortlisted Int @default(0)
  totalSelected    Int @default(0)

  avgCGPA Decimal? @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jdId, collegeName])
  @@index([jdId])
  @@index([collegeName]) // ADD: Search by college
  @@index([totalSelected]) // ADD: Sort by performance
  @@map("college_performance")
}
